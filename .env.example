APP_NAME=CryptoExchange
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=UTC
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=your-supabase-pooler-host
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=change-me
DB_SSLMODE=require
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
RATE_API_URL=https://api.coingecko.com/api/v3/simple/price
EXCHANGE_SPREAD_BPS=100
EXCHANGE_FEE_BPS=50
EXCHANGE_QUOTE_TTL=300
SUPPORT_EMAIL=support@your-domain.example
MAIL_MAILER=log
MAIL_FROM_ADDRESS=support@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"
